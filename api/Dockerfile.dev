# Development image — single stage for fast iteration.
# Hot reload via uvicorn --reload, source mounted as volume.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libffi-dev \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# CPU-only PyTorch wheel, pre-fetched by the shared klarki-torch:cpu image
# (docker/torch-base.Dockerfile) instead of downloading it here — same torch as
# prod, fetched once and reused. ./run.sh builds it automatically.
COPY --from=klarki-torch:cpu /wheels /wheels

# torch is installed in this SAME command as the requirements files (not a
# separate RUN) — see docker/torch-base.Dockerfile for why splitting it into two
# pip calls silently drags in several GB of unrelated CUDA packages.
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir --find-links=/wheels \
        "$(cat /wheels/torch_spec.txt)" -r requirements.txt -r requirements-dev.txt

RUN mkdir -p /data/uploads

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
